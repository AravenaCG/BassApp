es": 15, "materialId": "progresion"}, {"taskId": "S1T4", "instruction": "Escucha oido.wav sin soluciones y registra respuestas.", "minutes": 15, "materialId": "oido"}]}, {"sessionNumber": 2, "tasks": [{"taskId": "S2T1", "instruction": "Repite el contraste auditivo y canta las notas difíciles.", "minutes": 10, "materialId": "oido"}, {"taskId": "S2T2", "instruction": "Practica el pattern en grupos de tres; nombra los grados.", "minutes": 20, "materialId": "pattern"}, {"taskId": "S2T3", "instruction": "Acompaña con backing sin bajo, primero en two-feel.", "minutes": 20, "materialId": "progresion"}, {"taskId": "S2T4", "instruction": "Lee el solo; identifica notas de acorde y pasos.", "minutes": 10, "materialId": "solo"}]}, {"sessionNumber": 3, "tasks": [{"taskId": "S3T1", "instruction": "Escucha, canta y responde dos pruebas sin pentagrama.", "minutes": 10, "materialId": "oido"}, {"taskId": "S3T2", "instruction": "Toca el solo y crea una variante rítmica con silencios.", "minutes": 15, "materialId": "solo"}, {"taskId": "S3T3", "instruction": "Una vuelta con arpegios, otra con terceras y séptimas, otra con una 9 por dominante. Escribe las llegadas para no improvisar un único modo sobre toda la cadena.", "minutes": 25, "materialId": "progresion"}, {"taskId": "S3T4", "instruction": "Graba dos vueltas y anota una llegada que mejorar.", "minutes": 10, "materialId": "solo"}]}, {"sessionNumber": 4, "tasks": [{"taskId": "S4T1", "instruction": "Repasa el contraste sin nombres latinos visibles.", "minutes": 10, "materialId": "concepto"}, {"taskId": "S4T2", "instruction": "Repite lectura y oído; registra aciertos antes de comprobar.", "minutes": 15, "materialId": "oido"}, {"taskId": "S4T3", "instruction": "Graba acompañamiento y solo sobre la forma, con destinos conscientes.", "minutes": 25, "materialId": "progresion"}, {"taskId": "S4T4", "instruction": "Completa autoevaluación y decide si repetir semana.", "minutes": 10, "materialId": "solo"}]}], "selfAssessment": {"questions": [